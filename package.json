{
  "name": "offline-trading-journal",
  "productName": "Trading Journal",
  "version": "1.2.0",
  "private": true,
  "description": "A private offline desktop trading journal",
  "author": "Private Trading Journal",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop": "electron electron/main.cjs",
    "package:windows": "npm run build && electron-builder --win nsis portable",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.17.7",
    "sql.js": "^1.13.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "9.39.4",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "eslint-config-next": "16.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "build": {
    "appId": "local.tradingjournal.desktop",
    "productName": "Trading Journal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/sanitize-html/**/*",
      "node_modules/htmlparser2/**/*",
      "node_modules/domhandler/**/*",
      "node_modules/domutils/**/*",
      "node_modules/domelementtype/**/*",
      "node_modules/entities/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "codex-skill",
        "to": "codex-skill"
      }
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Trading-Journal-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Trading-Journal-Portable-${version}-${arch}.${ext}"
    }
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
